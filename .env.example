# Nova IDE Environment Configuration
# Copy to .env and fill in your values

# AI Providers
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
OLLAMA_BASE_URL=http://localhost:11434

# MCP Registry
MCP_REGISTRY_URL=https://toolsdk-ai.github.io/toolsdk-mcp-registry
MCP_SANDBOX_PROVIDER=LOCAL

# Browser Automation
BROWSER_HEADLESS=true
BROWSER_EXECUTABLE_PATH=

# App Settings
NOVA_DEFAULT_THEME=nova-dark
NOVA_DEFAULT_PROVIDER=openai
NOVA_DEFAULT_MODEL=gpt-4

# Development
VITE_API_URL=http://localhost:1420
VITE_DEBUG=false
