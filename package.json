{
  "name": "nova-subagent-system",
  "version": "2.0.0",
  "description": "Enterprise-grade autonomous sub-agent orchestration system",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nova": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/server.ts",
    "start": "node dist/server.js",
    "cli": "ts-node src/cli/index.ts",
    "nova": "ts-node src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.ts'",
    "format:check": "prettier --check '**/*.ts'",
    "nova:build": "tsc --project tsconfig.build.json",
    "nova:dev": "ts-node src/cli/index.ts",
    "nova:start": "node dist/cli/index.js",
    "nova:test": "vitest run",
    "nova:lint": "eslint src/ --ext .ts",
    "nova:format": "prettier --write src/",
    "nova:clean": "rm -rf dist",
    "nova:package": "npm run nova:build && npm pack",
    "docker:build": "docker build -t nova-agent .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down"
  },
  "dependencies": {
    "uuid": "^9.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
