{
  "name": "nova-subagent-ide",
  "version": "1.0.0",
  "description": "Autonomous AI-powered IDE with 147+ parallel agents, real-time streaming, real file operations, real terminal, real git integration, BYOK/BYOA support, 81 REST API endpoints, Electron desktop app, and production-grade security monitoring.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "nova": "./dist/cli/index.js"
  },
  "keywords": [
    "ai-ide",
    "autonomous-agents",
    "sub-agent",
    "llm",
    "code-generation",
    "ai-development",
    "ide",
    "code-editor",
    "electron-app",
    "typescript",
    "openai",
    "anthropic",
    "claude",
    "gpt-4",
    "multi-agent",
    "parallel-agents",
    "real-time",
    "websocket",
    "rest-api",
    "devtools",
    "developer-tools",
    "code-completion",
    "code-analysis",
    "byok",
    "byoa",
    "mcp",
    "lsp",
    "plugin-system",
    "extension-marketplace",
    "terminal",
    "git-integration",
    "file-explorer",
    "monaco-editor",
    "debug-adapter",
    "security-audit",
    "penetration-testing",
    "load-testing",
    "monitoring",
    "logging",
    "checkpoint",
    "diff-engine",
    "chat-system",
    "collaboration",
    "docker",
    "ci-cd",
    "cross-platform",
    "windows",
    "macos",
    "linux",
    "self-hosted",
    "open-source"
  ],
  "author": "asubilla",
  "license": "MIT",
  "homepage": "https://github.com/asubilla/Nova-IDE#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asubilla/Nova-IDE.git"
  },
  "bugs": {
    "url": "https://github.com/asubilla/Nova-IDE/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/server.ts",
    "start": "node dist/server.js",
    "cli": "ts-node src/cli/index.ts",
    "nova": "ts-node src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.ts'",
    "format:check": "prettier --check '**/*.ts'",
    "nova:build": "tsc --project tsconfig.build.json",
    "nova:dev": "ts-node src/cli/index.ts",
    "nova:start": "node dist/cli/index.js",
    "nova:test": "vitest run",
    "nova:lint": "eslint src/ --ext .ts",
    "nova:format": "prettier --write src/",
    "nova:clean": "rm -rf dist",
    "nova:package": "npm run nova:build && npm pack",
    "docker:build": "docker build -t nova-agent .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down"
  },
  "dependencies": {
    "uuid": "^9.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "electron": "^44.4.3",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  }
}
